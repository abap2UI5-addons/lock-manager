{
  // Syntax and style, resolved against the abap2UI5 core. There is no version
  // pin on that dependency - abaplint clones its main branch - which is why
  // the check workflow also runs weekly: a rename upstream breaks this
  // repository silently otherwise.
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/abap2UI5",
      // main on purpose (see the comment at the top), declared rather than
      // left off - abap2UI5 CONVENTIONS §9
      "branch": "main",
      "folder": "/abap2UI5",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    // v750, the same floor as the core. read_lock_requests( ) filters with
    // ranges, not with a host expression such as @iv_status IS INITIAL in the
    // WHERE clause, which needs 7.54. Older releases install the 702 branch
    // (publish-702).
    "version": "v750",
    // ^Z (not "."): this addon reads on-prem DDIC types and calls the kernel
    // ENQUEUE function modules, which the API set does not ship - with "."
    // every one of them is a false "not found". ^Z keeps the own namespace
    // fully checked and treats unknown SAP-standard objects as void, which
    // matches the on-prem target. Same reasoning as rap-ext.
    "errorNamespace": "^Z"
  },
  "rules": {
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "definitions_top": false,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true,
    // --- from abap2UI5's rule set (abap2UI5/abaplint.jsonc) ---
    "7bit_ascii": true,
    "add_test_attributes": true,
    "aff_and_xml": true,
    "allowed_object_naming": true,
    "ambiguous_statement": true,
    "begin_single_include": true,
    "call_transaction_authority_check": true,
    "catch_and_raise": {
      // the vendored abap-util copies stay byte-close to the master (AGENTS.md)
      "exclude": ["z2ui5_cl_lock_context", "z2ui5_cx_lock_error"]
    },
    "cds_association_name": true,
    "cds_field_order": true,
    "cds_parser_error": true,
    "chain_mainly_declarations": true,
    "change_if_to_case": true,
    "check_abstract": true,
    "check_text_elements": true,
    "check_transformation_exists": true,
    "classic_exceptions_overlap": true,
    "clear_exporting_parameters": true,
    "cloud_types": true,
    "colon_missing_space": true,
    "constant_classes": true,
    "constructor_visibility_public": true,
    "contains_tab": true,
    "cyclic_oo": {
      "exclude": [],
      "skip": [
        "Z2UI5_IF_APP",
        "Z2UI5_IF_CLIENT",
        "Z2UI5_CL_UI5_ACTION",
        "Z2UI5_CL_UI5_HANDLER"
      ],
      "skipSharedMemory": true,
      "skipTestclasses": true
    },
    "cyclomatic_complexity": {
      // the vendored abap-util copies stay byte-close to the master (AGENTS.md)
      "exclude": ["z2ui5_cl_lock_context", "z2ui5_cx_lock_error"],
      "max": 10,
      "severity": "Error"
    },
    "dangerous_statement": {
      "deleteDynpro": true,
      "deleteReport": true,
      "deleteTextpool": true,
      "dynamicSQL": true,
      "exclude": [],
      "execSQL": true,
      "exportDynpro": true,
      "generateDynpro": true,
      "generateReport": true,
      "generateSubroutine": true,
      "insertReport": true,
      "insertTextpool": true,
      "kernelCall": true,
      "severity": "Error",
      "systemCall": true
    },
    "description_empty": true,
    "downport": true,
    "dynpro_checks": true,
    "easy_to_find_messages": true,
    "else_after_all_returns": true,
    "empty_event": true,
    "empty_statement": true,
    "empty_structure": {
      "loop": false,
      "if": true,
      "while": true,
      "case": true,
      "select": false,
      "do": true,
      "at": true,
      "try": true,
      "when": false,
      "catch": true
    },
    "exit_or_check": true,
    "expand_macros": true,
    "exporting": true,
    "fm_global_parameters_obsolete": true,
    "forbidden_identifier": true,
    "forbidden_pseudo_and_pragma": {
      "exclude": [],
      "ignoreGlobalClassDefinition": false,
      "ignoreGlobalInterface": false,
      "pragmas": [],
      "pseudo": [],
      "severity": "Error"
    },
    "form_tables_obsolete": true,
    "fully_type_constants": {
      "checkData": true,
      "exclude": []
    },
    "fully_type_itabs": true,
    "functional_writing": {
      "exclude": [],
      "ignoreExceptions": true
    },
    "identical_conditions": true,
    "identical_contents": true,
    "identical_descriptions": true,
    "identical_form_names": true,
    "identical_move": true,
    "implicit_start_of_selection": true,
    "index_completely_contained": true,
    "inline_data_old_versions": true,
    "intf_referencing_clas": {
      "allow": [
        "^cl_abap_"
      ],
      "exclude": []
    },
    "invalid_table_index": true,
    "line_break_style": true,
    "local_testclass_consistency": true,
    "macro_naming": true,
    "main_file_contents": true,
    "many_parentheses": true,
    "max_one_method_parameter_per_line": true,
    "max_one_statement": true,
    "message_exists": true,
    "method_overwrites_builtin": {
      "exclude": [],
      "severity": "Error"
    },
    "modify_only_own_db_tables": {
      "exclude": [],
      "ownTables": "^[yz]",
      "reportDynamic": true
    },
    "msag_consistency": true,
    "names_no_dash": true,
    "nesting": {
      "depth": 5,
      "exclude": []
    },
    "newline_between_methods": true,
    "no_aliases": true,
    "no_chained_assignment": true,
    "no_comments_between_methods": true,
    "no_external_form_calls": true,
    "no_yoda_conditions": true,
    "nrob_consistency": true,
    "obsolete_statement": true,
    "omit_parameter_name": true,
    "omit_preceding_zeros": true,
    "omit_receiving": true,
    "parser_702_chaining": true,
    "parser_bad_exceptions": true,
    "parser_missing_space": true,
    "pragma_style": true,
    "prefer_abap_bool": true,
    "prefer_abap_bool_values": true,
    "prefer_is_not": true,
    "prefer_pragmas": true,
    "prefer_raise_exception_new": {
      // the vendored abap-util copies stay byte-close to the master (AGENTS.md)
      "exclude": ["z2ui5_cl_lock_context", "z2ui5_cx_lock_error"]
    },
    "prefer_returning_to_exporting": true,
    "prefer_xsdbool": true,
    "preferred_compare_operator": true,
    "preferred_parameter_ignored": true,
    "prefix_is_current_class": {
      "exclude": [],
      "severity": "Warning"
    },
    "reduce_procedural_code": true,
    "reduce_string_templates": true,
    "redundant_conversion": true,
    "release_idoc": true,
    "remove_descriptions": {
      "exclude": [],
      "ignoreExceptions": false,
      "ignoreWorkflow": false,
      "severity": "Error"
    },
    "rfc_error_handling": true,
    "select_single_full_key": true,
    "selection_screen_naming": true,
    "sequential_blank": {
      "exclude": [],
      "severity": "Warning"
    },
    "short_case": true,
    "sicf_consistency": true,
    "slow_parameter_passing": true,
    "sql_escape_host_variables": true,
    "sql_value_conversion": true,
    "static_call_via_instance": {
      "allowInTestclassIncludes": false,
      "exclude": []
    },
    "strict_sql": true,
    "superfluous_value": true,
    "sy_modification": true,
    "tabl_enhancement_category": true,
    "tables_declared_locally": true,
    "try_without_catch": true,
    "type_form_parameters": true,
    "uncaught_exception": true,
    "unnecessary_loop_guard": true,
    "unnecessary_pragma": true,
    "unreachable_code": true,
    "unsecure_fae": true,
    "unused_ddic": true,
    "unused_macros": true,
    "unused_methods": true,
    "unused_types": true,
    "unused_variables": {
      "severity": "Error",
      "skipNames": [
        "lv_dummy",
        "lv_dummy2",
        "lv_dummy3",
        "lv_dummy4",
        "<dummy>"
      ]
    },
    "use_bool_expression": true,
    "use_class_based_exceptions": true,
    "use_line_exists": true,
    "use_message_class": true,
    "use_new": true,
    "when_others_last": true,
    "whitespace_end": true,
    "wrong_abapdoc_position": true,
    "xml_bom": true,
    // added 2026-11: the rules of abap2UI5's abaplint.jsonc this repository
    // passes without a finding, with its settings, and allowed_object_types
    // with the object types this repository ships
    "abapdoc_html_tag": true,
    "abapdoc_leading_at": true,
    "abapdoc_parameter_names": true,
    "abapdoc_shorttext_length": true,
    "allowed_object_types": {
      "allowed": [
        "CLAS",
        "DEVC",
        "PROG",
        "TABL"
      ]
    },
    "bound_check_after_create": true,
    "cds_comment_style": true,
    "cds_legacy_view": true,
    "changing_sorted_line": true,
    "clear_after_declaration": true,
    "clear_before_overwrite": true,
    "constant_condition": true,
    "copy_of_initial_variable": true,
    "delete_index_in_loop": true,
    "final_newline": true,
    // an allow list matching no object: the default, empty, allows every one
    "forbidden_kernel_write": {
      "allow": [
        "^$"
      ]
    },
    "inline_packed_computation": true,
    "is_assigned_in_loop": true,
    "no_mandt_in_database_operations": true,
    "object_naming": {
      "severity": "Error",
      "patternKind": "required",
      "ignoreNames": [],
      "ignorePatterns": [],
      "clas": "^Z2UI5_C(L|X)",
      "intf": "^Z2UI5_IF",
      "prog": "^Z",
      "fugr": "^Z",
      "tabl": "^Z",
      "ttyp": "^Z",
      "dtel": "^Z",
      "doma": "^Z",
      "msag": "^Z",
      "tran": "^Z",
      "enqu": "^EZ",
      "auth": "^Z",
      "pinf": "^Z",
      "idoc": "^Z",
      "xslt": "^Z",
      "ssfo": "^Z",
      "ssst": "^Z",
      "shlp": "^Z"
    },
    "range_row_values": true,
    "redundant_cast": true,
    "smim_consistency": true,
    "sort_empty_key": true,
    "subrc_after_assign": true,
    // The rest of abap2UI5's rule set, added 2026-11 with their findings
    // fixed, no exceptions.
    "if_in_if": true,
    "unnecessary_chaining": true,
    "unnecessary_return": true,
    // added 2026-11: newer abaplint rules that report nothing here
    "abapdoc_short_link": true,
    "boolean_flag_via_if": true,
    "cast_via_generic_reference": true
  }
}
